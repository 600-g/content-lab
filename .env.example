# 콘텐츠랩 환경변수 (.env로 복사 후 채울 것)
# .env 파일은 gitignore — 절대 커밋 금지

# === Gemini (필수) ===
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Notion (필수 — master DB 등록용) ===
# 1. https://www.notion.so/my-integrations 에서 Internal Integration Token 발급
# 2. DB 페이지에서 Connections → 인티그레이션 추가
NOTION_API_KEY=
NOTION_DB_ID=490d8ced-a27b-40a7-b9bb-bd03549ebbc6
NOTION_HUB_PAGE_ID=35d14362-1b4b-81bd-99e5-ecea5910644a

# === 스킬 설치 경로 ===
# ECC 표준. 두근컴퍼니 모든 에이전트가 이 경로에서 스킬을 발견함.
SKILL_INSTALL_DIR=~/.claude/skills

# === 옵션 ===
LOG_LEVEL=INFO
DEFAULT_LANG=ko
